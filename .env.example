# Copie para ~/.config/hangar/hangar.env (chmod 600) ou exporte no ambiente.
# A aba Ajustes também grava aqui. Nada disso volta para o navegador.
HANGAR_GLPI_URL=https://glpi.exemplo.com
HANGAR_GLPI_APP_TOKEN=
HANGAR_GLPI_USER_TOKEN=

# TickTick Open API (developer.ticktick.com). O botão Conectar TickTick em Ajustes grava o token.
HANGAR_TICKTICK_CLIENT_ID=
HANGAR_TICKTICK_CLIENT_SECRET=
HANGAR_TICKTICK_TOKEN=

# Google Agenda (cliente OAuth "App para computador" no Google Cloud). O botão Conectar Google Agenda grava o refresh token.
HANGAR_GOOGLE_CLIENT_ID=
HANGAR_GOOGLE_CLIENT_SECRET=
HANGAR_GOOGLE_REFRESH_TOKEN=

# Qualquer chave do config.json pode vir do ambiente: HANGAR_<SEÇÃO>_<CHAVE> (listas em JSON).
# HANGAR_PORT=8023
# HANGAR_VAULT=~/Obsidian/Pessoal
# HANGAR_TRABALHO_GITHUB_ORG=acme
# HANGAR_CONFIG=~/.config/hangar/config.json
